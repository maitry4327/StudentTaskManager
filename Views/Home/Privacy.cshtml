@{
    ViewData["Title"] = "Privacy Policy";
}

<style>
    .privacy-page {
        max-width: 1000px;
        margin: 35px auto 55px;
        padding: 0 15px;
        color: #252b48;
    }

    .privacy-hero {
        background: linear-gradient(135deg, #312e81, #4f46e5, #8b5cf6);
        color: white;
        padding: 45px 35px;
        border-radius: 22px;
        position: relative;
        overflow: hidden;
        margin-bottom: 30px;
    }

        .privacy-hero::after {
            content: "";
            position: absolute;
            width: 210px;
            height: 210px;
            right: -55px;
            top: -75px;
            border: 32px solid rgba(255,255,255,.10);
            border-radius: 50%;
        }

    .privacy-icon {
        display: flex;
        width: 58px;
        height: 58px;
        align-items: center;
        justify-content: center;
        background: rgba(255,255,255,.16);
        border-radius: 17px;
        font-size: 29px;
        margin-bottom: 20px;
        position: relative;
        z-index: 1;
    }

    .privacy-hero h1 {
        font-size: clamp(30px, 5vw, 40px);
        font-weight: 800;
        margin-bottom: 12px;
        position: relative;
        z-index: 1;
    }

    .privacy-hero p {
        max-width: 650px;
        color: rgba(255,255,255,.85);
        font-size: 15px;
        line-height: 1.8;
        margin-bottom: 0;
        position: relative;
        z-index: 1;
    }

    .privacy-note {
        display: flex;
        gap: 14px;
        align-items: flex-start;
        background: #eef2ff;
        border: 1px solid #c7d2fe;
        padding: 19px;
        border-radius: 15px;
        margin-bottom: 25px;
    }

    .privacy-note-icon {
        font-size: 24px;
    }

    .privacy-note h3 {
        font-size: 15px;
        font-weight: 800;
        margin: 0 0 7px;
        color: #3730a3;
    }

    .privacy-note p {
        font-size: 13px;
        line-height: 1.8;
        color: #4b5563;
        margin: 0;
    }

    .privacy-card {
        background: #fff;
        border: 1px solid #e8eaf2;
        border-radius: 17px;
        padding: 25px;
        margin-bottom: 18px;
        box-shadow: 0 6px 22px rgba(35,35,75,.04);
    }

    .privacy-card-header {
        display: flex;
        gap: 14px;
        align-items: center;
        margin-bottom: 15px;
    }

    .privacy-card-icon {
        display: flex;
        width: 46px;
        height: 46px;
        flex-shrink: 0;
        align-items: center;
        justify-content: center;
        background: #ede9fe;
        border-radius: 13px;
        font-size: 22px;
    }

    .privacy-card h2 {
        color: #252b48;
        font-size: 18px;
        font-weight: 800;
        margin: 0;
    }

    .privacy-card p {
        color: #6b7280;
        font-size: 14px;
        line-height: 1.9;
        margin-bottom: 0;
    }

    .privacy-card ul {
        color: #6b7280;
        font-size: 14px;
        line-height: 2;
        margin-bottom: 0;
        padding-left: 22px;
    }

    .privacy-card li::marker {
        color: #6366f1;
    }

    .privacy-footer {
        text-align: center;
        background: #f5f3ff;
        border: 1px solid #ede9fe;
        border-radius: 17px;
        padding: 27px 20px;
        margin-top: 28px;
    }

        .privacy-footer h3 {
            color: #3730a3;
            font-size: 18px;
            font-weight: 800;
            margin-bottom: 10px;
        }

        .privacy-footer p {
            color: #6b7280;
            font-size: 14px;
            line-height: 1.8;
            margin-bottom: 18px;
        }

    .privacy-home-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #4f46e5, #7c3aed);
        color: white;
        text-decoration: none;
        font-size: 14px;
        font-weight: 700;
        padding: 12px 21px;
        border-radius: 11px;
        transition: transform .2s;
    }

        .privacy-home-btn:hover {
            color: white;
            transform: translateY(-2px);
        }

    @@media (max-width: 576px) {
        .privacy-page {
            margin-top: 20px;
            padding: 0 10px;
        }

        .privacy-hero {
            padding: 30px 22px;
        }

        .privacy-card {
            padding: 20px;
        }

            .privacy-card h2 {
                font-size: 16px;
            }
    }
</style>

<div class="privacy-page">

    <!-- Privacy Header -->
    <section class="privacy-hero">

        <div class="privacy-icon">🔐</div>

        <h1>Privacy Policy</h1>

        <p>
            Your privacy matters. This page explains how the Student Task
            Manager is intended to handle assignment information and how
            users can help keep their information secure.
        </p>

    </section>

    <!-- Important Note -->
    <div class="privacy-note">

        <div class="privacy-note-icon">ℹ️</div>

        <div>
            <h3>About This Project</h3>

            <p>
                Student Task Manager is an academic project developed to
                demonstrate assignment management, database operations,
                form validation, and web application design. The statements
                below describe the intended privacy practices and should
                be checked against the actual implementation before deployment.
            </p>
        </div>

    </div>

    <!-- Information Collection -->
    <section class="privacy-card">

        <div class="privacy-card-header">

            <div class="privacy-card-icon">📋</div>

            <h2>1. Information Handled by the Application</h2>

        </div>

        <p>
            The application may store assignment information entered by the
            user, including assignment title, subject, description, due date,
            status, and creation date. The information stored depends on the
            application's implemented features and database configuration.
        </p>

    </section>

    <!-- Information Usage -->
    <section class="privacy-card">

        <div class="privacy-card-header">

            <div class="privacy-card-icon">⚙️</div>

            <h2>2. How Information Is Used</h2>

        </div>

        <p>
            Assignment information is used to display assignment details,
            support creating and updating records, filter assignments,
            and calculate dashboard statistics. These operations support
            the academic task-management purpose of the project.
        </p>

    </section>

    <!-- Database -->
    <section class="privacy-card">

        <div class="privacy-card-header">

            <div class="privacy-card-icon">🗄️</div>

            <h2>3. Database and Storage</h2>

        </div>

        <p>
            The project uses a MySQL database through Entity Framework Core.
            Database access, backups, and permissions should be configured
            appropriately. The actual storage and access controls depend on
            the environment where the application is hosted.
        </p>

    </section>

    <!-- Security -->
    <section class="privacy-card">

        <div class="privacy-card-header">

            <div class="privacy-card-icon">🛡️</div>

            <h2>4. Security Practices</h2>

        </div>

        <ul>
            <li>Keep database credentials private.</li>
            <li>Use appropriate validation for submitted form data.</li>
            <li>Restrict database access to authorized users.</li>
            <li>Use HTTPS when deploying the application publicly.</li>
            <li>Do not enter sensitive personal information into a demonstration project.</li>
        </ul>

    </section>

    <!-- Cookies and Sessions -->
    <section class="privacy-card">

        <div class="privacy-card-header">

            <div class="privacy-card-icon">🍪</div>

            <h2>5. Cookies and Sessions</h2>

        </div>

        <p>
            ASP.NET Core session functionality may be used to maintain
            temporary application state. The data held in a session and
            its lifetime depend on the application's configuration.
            This project should be reviewed to confirm exactly what
            session data is stored.
        </p>

    </section>

    <!-- Third Party -->
    <section class="privacy-card">

        <div class="privacy-card-header">

            <div class="privacy-card-icon">🔗</div>

            <h2>6. Third-Party Services</h2>

        </div>

        <p>
            The project should disclose any external services, analytics,
            or third-party resources it actually uses. No claim is made
            here that the application has no third-party connections;
            this must be verified from its implementation.
        </p>

    </section>

    <!-- Policy Updates -->
    <section class="privacy-card">

        <div class="privacy-card-header">

            <div class="privacy-card-icon">🔄</div>

            <h2>7. Policy Updates</h2>

        </div>

        <p>
            This privacy notice may need to be updated if the application's
            features, data collection, storage, or hosting arrangements change.
            Review the policy before using the project with real users or
            deploying it publicly.
        </p>

    </section>

    <!-- Footer -->
    <section class="privacy-footer">

        <h3>Questions About This Project?</h3>

        <p>
            Return to the Student Task Manager home page to explore
            the application's features.
        </p>

        <a asp-controller="Home"
           asp-action="Index"
           class="privacy-home-btn">
            ← &nbsp; Back to Home
        </a>

    </section>

</div>
