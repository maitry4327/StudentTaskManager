@model StudentTaskManager.Models.Assignment

@{
    ViewData["Title"] = "Assignment Details";

    var statusClass = Model.Status switch
    {
        "Completed" => "status-completed",
        "In Progress" => "status-progress",
        _ => "status-pending"
    };

    var isOverdue = Model.Status != "Completed"
                    && Model.DueDate.Date < DateTime.Today;
}

<style>
    .details-page {
        max-width: 950px;
        margin: 35px auto 55px;
        padding: 0 15px;
    }

    .details-card {
        background: #fff;
        border: 1px solid #e8eaf2;
        border-radius: 20px;
        box-shadow: 0 12px 35px rgba(35, 35, 75, 0.09);
        overflow: hidden;
    }

    .details-header {
        background: linear-gradient(135deg, #4338ca, #7c3aed);
        color: #fff;
        padding: 30px;
        position: relative;
        overflow: hidden;
    }

        .details-header::after {
            content: "";
            position: absolute;
            width: 190px;
            height: 190px;
            right: -45px;
            top: -75px;
            border: 30px solid rgba(255, 255, 255, 0.10);
            border-radius: 50%;
        }

    .details-icon {
        display: inline-flex;
        width: 48px;
        height: 48px;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.18);
        border-radius: 14px;
        font-size: 25px;
        margin-bottom: 15px;
    }

    .details-header h2 {
        font-size: 27px;
        font-weight: 750;
        margin-bottom: 8px;
        position: relative;
        z-index: 1;
    }

    .details-header p {
        margin: 0;
        color: rgba(255, 255, 255, 0.85);
        position: relative;
        z-index: 1;
    }

    .assignment-id {
        display: inline-block;
        background: rgba(255, 255, 255, 0.17);
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 12px;
        margin-bottom: 12px;
        position: relative;
        z-index: 1;
    }

    .details-body {
        padding: 32px;
    }

    .assignment-title {
        color: #252b48;
        font-size: 25px;
        font-weight: 750;
        overflow-wrap: anywhere;
        margin-bottom: 10px;
    }

    .assignment-subtitle {
        color: #7b8196;
        font-size: 14px;
        margin-bottom: 25px;
    }

    .info-panel {
        background: #f8f9ff;
        border: 1px solid #edf0fa;
        border-radius: 14px;
        padding: 22px;
        margin-bottom: 25px;
    }

    .info-item {
        padding: 15px 0;
        border-bottom: 1px solid #e8eaf3;
    }

        .info-item:first-child {
            padding-top: 0;
        }

        .info-item:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

    .info-label {
        color: #7b8196;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.6px;
        margin-bottom: 7px;
    }

    .info-value {
        color: #252b48;
        font-size: 15px;
        font-weight: 550;
        overflow-wrap: anywhere;
    }

    .description-box {
        background: #fff;
        border: 1px solid #e5e7f0;
        border-radius: 12px;
        padding: 15px;
        min-height: 65px;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        line-height: 1.7;
    }

    .status-badge {
        display: inline-block;
        padding: 7px 13px;
        border-radius: 30px;
        font-size: 12px;
        font-weight: 700;
    }

    .status-completed {
        color: #047857;
        background: #d1fae5;
    }

    .status-progress {
        color: #1d4ed8;
        background: #dbeafe;
    }

    .status-pending {
        color: #92400e;
        background: #fef3c7;
    }

    .status-overdue {
        color: #b91c1c;
        background: #fee2e2;
    }

    .details-divider {
        border: 0;
        border-top: 1px solid #edf0f6;
        margin: 28px 0;
    }

    .details-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
    }

    .btn-details-edit {
        border: none;
        border-radius: 11px;
        padding: 12px 22px;
        color: #fff;
        font-weight: 650;
        background: linear-gradient(135deg, #4f46e5, #7c3aed);
        box-shadow: 0 5px 14px rgba(79, 70, 229, 0.22);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.2s;
    }

        .btn-details-edit:hover {
            color: #fff;
            transform: translateY(-2px);
        }

    .btn-details-back {
        border: 1px solid #dfe3ee;
        border-radius: 11px;
        padding: 12px 22px;
        color: #4b5563;
        background: #fff;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

        .btn-details-back:hover {
            background: #f8f9fc;
            color: #252b48;
        }

    @@media (max-width: 576px) {
        .details-page {
            margin-top: 20px;
            padding: 0 10px;
        }

        .details-header {
            padding: 24px 20px;
        }

            .details-header h2 {
                font-size: 23px;
            }

        .details-body {
            padding: 22px 18px;
        }

        .assignment-title {
            font-size: 21px;
        }

        .info-panel {
            padding: 17px;
        }

        .details-actions .btn {
            width: 100%;
        }
    }
</style>

<div class="details-page">

    <div class="details-card">

        <!-- Header -->
        <div class="details-header">

            <div class="details-icon">📋</div>

            <div class="assignment-id">
                Assignment ID: #@Model.Id
            </div>

            <h2>Assignment Details</h2>

            <p>View your assignment information and track its progress.</p>

        </div>

        <!-- Details Content -->
        <div class="details-body">

            <h3 class="assignment-title">@Model.Title</h3>

            <p class="assignment-subtitle">
                Subject: @Model.Subject
            </p>

            <div class="info-panel">

                <div class="info-item">
                    <div class="info-label">Assignment ID</div>
                    <div class="info-value">#@Model.Id</div>
                </div>

                <div class="info-item">
                    <div class="info-label">Assignment Title</div>
                    <div class="info-value">@Model.Title</div>
                </div>

                <div class="info-item">
                    <div class="info-label">Subject</div>
                    <div class="info-value">@Model.Subject</div>
                </div>

                <div class="info-item">
                    <div class="info-label">Description</div>

                    <div class="description-box">
                        @(string.IsNullOrWhiteSpace(Model.Description)
                        ? "No description provided."
                        : Model.Description)
                    </div>
                </div>

                <div class="info-item">
                    <div class="info-label">Due Date</div>

                    <div class="info-value">
                        📅 @Model.DueDate.ToString("dd MMM yyyy")
                    </div>
                </div>

                <div class="info-item">
                    <div class="info-label">Assignment Status</div>

                    @if (isOverdue)
                    {
                        <span class="status-badge status-overdue">
                            ⚠ Overdue
                        </span>
                    }
                    else
                    {
                        <span class="status-badge @statusClass">
                            @Model.Status
                        </span>
                    }
                </div>

                <div class="info-item">
                    <div class="info-label">Created At</div>

                    <div class="info-value">
                        @Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")
                    </div>
                </div>

            </div>

            <hr class="details-divider" />

            <!-- Action Buttons -->
            <div class="details-actions">

                <a asp-controller="Assignments"
                   asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-details-edit">
                    ✏️ &nbsp; Edit Assignment
                </a>

                <a asp-controller="Assignments"
                   asp-action="Index"
                   class="btn btn-details-back">
                    ← &nbsp; Back to Assignments
                </a>

            </div>

        </div>

    </div>

</div>
